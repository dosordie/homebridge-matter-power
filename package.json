  "author": "dosordie",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dosordie/homebridge-matter-power.git"
  },
  "bugs": {
    "url": "https://github.com/dosordie/homebridge-matter-power/issues"
  },
  "homepage": "https://github.com/dosordie/homebridge-matter-power#readme",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0",
    "homebridge": ">=2.4.0 <3.0.0"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "homebridge-plugin",
    "homebridge",
